# Database connectivity for frontend API routes
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=mtr_dashboard

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mtr_metrics

# Optional: backend service checks used by /api/backend/overview
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# API security
# Enable strict auth even if no token map is provided
SECURITY_ENFORCE_AUTH=true
SESSION_SECRET=replace-with-long-random-secret-min-32-chars
SESSION_DURATION_HOURS=12

# Initial auth users (used by scripts/seed-auth-users.mjs)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-with-strong-admin-password
AUTH_OPERATOR_USERNAME=operator
AUTH_OPERATOR_PASSWORD=replace-with-strong-operator-password
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=replace-with-strong-viewer-password

# Optional token auth fallback (for API clients)
API_TOKEN_VIEWER=
API_TOKEN_OPERATOR=
API_TOKEN_ADMIN=

# Option B: JSON map (token -> role), example:
# API_TOKENS_JSON={"viewer-token":"viewer","operator-token":"operator","admin-token":"admin"}
API_TOKENS_JSON=
