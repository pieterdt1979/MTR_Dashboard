# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-strong-mysql-password
MYSQL_DATABASE=mtr_dashboard

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mtr_metrics
MONGODB_COLLECTION=mtr_results

# Polling Configuration
POLLING_INTERVAL_MINUTES=5
CLEANUP_INTERVAL_HOURS=1
MTR_COUNT=10

# fping sweep settings
FPING_COUNT=3
FPING_INTERVAL_MS=10
FPING_PERIOD_MS=500
FPING_TIMEOUT_SECONDS=40

# Trigger engine settings
MTR_FORCE_INTERVAL_MINUTES=60
MTR_JITTER_THRESHOLD_MS=5
MTR_CONSECUTIVE_BREACHES=2
MTR_TRIGGER_COOLDOWN_MINUTES=15
MTR_BASELINE_ALPHA=0.2
MTR_MAX_WORKERS=10

# Dispatch mode: direct | rabbitmq-producer | rabbitmq-worker
MTR_DISPATCH_MODE=direct
MTR_JOB_QUEUE=mtr_jobs

# RabbitMQ (used when dispatch mode is rabbitmq-*)
RABBITMQ_URL=amqp://set-rabbitmq-user:set-rabbitmq-password@localhost:5672/%2f

# PostgreSQL trigger state store
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mtr_state_user
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=mtr_state
POSTGRES_STATE_TABLE=device_probe_state

# Logging
LOG_LEVEL=INFO
LOG_FILE=mtr_poller.log