# MTR Phase 2 API (FastAPI + SNMP poller + burst manager) — Red Hat UBI9 Python 3.11
# Build context = repository root. The source lives in backend_v2/ (so the legacy backend/ with
# mtr_poller.py is untouched) but is installed in the image as the Python package `backend`:
#   podman build -f backend_v2/Containerfile -t localhost/mtr/api:phase2 .
# Host networking: uvicorn binds 0.0.0.0:${MTR_API_PORT:-8000} directly; nothing is EXPOSEd/published.
FROM registry.access.redhat.com/ubi9/python-311:latest

USER 0
WORKDIR /opt/app-root/src

COPY backend_v2/requirements.txt /tmp/requirements-api.txt
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r /tmp/requirements-api.txt \
 && rm -f /tmp/requirements-api.txt

# Only the Phase 2 Python package, installed under the import name `backend`.
COPY backend_v2/__init__.py backend_v2/config.py ./backend/
COPY backend_v2/db         ./backend/db
COPY backend_v2/poller     ./backend/poller
COPY backend_v2/api        ./backend/api
COPY backend_v2/migrations ./backend/migrations

RUN chown -R 1001:0 /opt/app-root/src && chmod -R g=u /opt/app-root/src

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MTR_API_HOST=0.0.0.0 \
    MTR_API_PORT=8000 \
    MTR_API_WORKERS=4

USER 1001

# Health check lives in podman-compose.yml (HEALTHCHECK is ignored for OCI-format podman builds).

# Shell form so MTR_API_* can be overridden at runtime; exec keeps uvicorn as PID 1.
CMD exec uvicorn backend.api.main:app --host "${MTR_API_HOST}" --port "${MTR_API_PORT}" \
    --workers "${MTR_API_WORKERS}" --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
