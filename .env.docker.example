# Copy to .env.docker or use scripts/docker-first-run.sh to generate.

# Ports
FRONTEND_PORT=3000
MYSQL_PORT=3306
MONGODB_PORT=27017
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=mtr_dashboard
MYSQL_USER=mtr_app
MYSQL_PASSWORD=replace-with-strong-app-password

# MongoDB
MONGODB_DATABASE=mtr_metrics
MONGODB_COLLECTION=mtr_results
MONGODB_FPING_COLLECTION=fping_status
MONGODB_FPING_HISTORY_COLLECTION=fping_results
MONGODB_REALTIME_FPING_COLLECTION=fping_realtime_results
MONGODB_REALTIME_SESSION_COLLECTION=realtime_probe_sessions
MONGODB_PROBE_REQUEST_COLLECTION=probe_requests
MONGODB_REALTIME_TTL_SECONDS=86400

# PostgreSQL trigger state
POSTGRES_DB=mtr_state
POSTGRES_USER=mtr_state_user
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_STATE_TABLE=device_probe_state

# Poller
POLLING_INTERVAL_MINUTES=5
CLEANUP_INTERVAL_HOURS=1
MTR_COUNT=10
MTR_PROBE_MODE=icmp
MTR_TCP_PORT=443
MTR_UDP_PORT=33434

# fping sweep settings
FPING_COUNT=3
FPING_INTERVAL_MS=10
FPING_PERIOD_MS=500
FPING_TIMEOUT_SECONDS=40

# Trigger policy
MTR_FORCE_INTERVAL_MINUTES=60
MTR_JITTER_THRESHOLD_MS=5
MTR_CONSECUTIVE_BREACHES=2
MTR_TRIGGER_COOLDOWN_MINUTES=15
MTR_BASELINE_ALPHA=0.2
MTR_MAX_WORKERS=10
REALTIME_MAX_ACTIVE_SESSIONS=5

# Dispatch mode: direct | rabbitmq-producer | rabbitmq-worker
MTR_DISPATCH_MODE=direct
MTR_JOB_QUEUE=mtr_jobs
RABBITMQ_URL=amqp://set-rabbitmq-user:set-rabbitmq-password@127.0.0.1:5672/%2f

# Logging
LOG_LEVEL=INFO
LOG_FILE=mtr_poller.log

# Frontend auth/session
SECURITY_ENFORCE_AUTH=true
SESSION_SECRET=replace-with-long-random-secret-min-32-chars
SESSION_DURATION_HOURS=12

AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-with-strong-admin-password
AUTH_OPERATOR_USERNAME=operator
AUTH_OPERATOR_PASSWORD=replace-with-strong-operator-password
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=replace-with-strong-viewer-password
