# =============================================================================
# MTR Dashboard Phase 1 — environment template
# Copy to .env (git-ignored) and replace every CHANGEME. podman-compose reads ./.env
# automatically. Never commit the real .env.
#   Generate strong values:   openssl rand -base64 32
# =============================================================================

# --- PostgreSQL 16 (inventory, incidents, burst sessions) --------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mtr_dashboard
POSTGRES_USER=mtr_app
POSTGRES_PASSWORD=CHANGEME

# --- ClickHouse (syslog, netflow, interface metrics) -------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=mtr
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGEME

# --- Redis (cache / burst-session fan-out) -----------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional but recommended (host networking exposes 6379 on all interfaces).
REDIS_PASSWORD=

# --- Poller -------------------------------------------------------------------
MTR_POLL_INTERVAL=300       # seconds, normal SNMP/ICMP polling cadence
MTR_BURST_INTERVAL=30       # seconds, cadence while a burst session is active
MTR_BURST_MAX_HOURS=8       # hard cap; enforced in PostgreSQL (burst_sessions CHECK + auto_expire_bursts)
LOG_LEVEL=INFO

# AES-256-GCM key for *_enc credential columns (application-layer encryption).
# base64 of exactly 32 random bytes:  openssl rand -base64 32
MTR_CREDENTIAL_KEY=CHANGEME

# --- Collectors (host networking: these are real host ports) ------------------
SYSLOG_PORT=514             # <1024 needs rootful podman (see README) — or use 1514 + firewall redirect
GOFLOW2_NETFLOW_PORT=2055   # NetFlow v5/v9, IPFIX, Huawei NetStream
GOFLOW2_SFLOW_PORT=6343
GOFLOW2_METRICS_ADDR=127.0.0.1:8081
GOFLOW2_ROTATE_SECS=15

# --- Frontend ------------------------------------------------------------------
FRONTEND_PORT=3000
SECURITY_ENFORCE_AUTH=true
SESSION_SECRET=CHANGEME_min_32_chars
SESSION_DURATION_HOURS=12
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=CHANGEME
AUTH_OPERATOR_USERNAME=operator
AUTH_OPERATOR_PASSWORD=CHANGEME
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=CHANGEME

# --- Phase 2 API (mtr-api, backend_v2/) ---------------------------------------
# Shared secret between the Next.js /api/v2 proxy and FastAPI (openssl rand -base64 32).
MTR_API_SHARED_SECRET=CHANGEME
MTR_API_PORT=8000
MTR_API_WORKERS=4
BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
SNMP_POLLER_ENABLED=true

# --- Legacy stores (OPTIONAL, transitional) ----------------------------------
# The current mtr_poller.py and frontend API routes still read MySQL + MongoDB until the
# Phase 2 port. Point these at an existing legacy deployment if you need them meanwhile.
#MYSQL_HOST=
#MYSQL_PORT=3306
#MYSQL_USER=
#MYSQL_PASSWORD=
#MYSQL_DATABASE=
#MONGODB_URI=
#MONGODB_DATABASE=
